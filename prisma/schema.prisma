generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Example {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum UserRole {
    USER
    ADMIN
}

enum PlanBillingCycle {
    MONTHLY
    YEARLY
}

enum SubscriptionStatus {
    TRIALING
    ACTIVE
    CANCELED
    PAST_DUE
    INCOMPLETE
}

enum InstrumentType {
    LAW
    REGULATION
    DECISION
}

enum ProvisionType {
    ARTICLE
    SECTION
    CLAUSE
}

enum MappingRelationType {
    IMPLEMENTS
    REFERENCES
    EXPLAINS
}

enum ChatRole {
    USER
    ASSISTANT
    SYSTEM
}

enum UploadFileType {
    PDF
    IMAGE
    TEXT
    DOCX
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    role          UserRole  @default(USER)
    passwordHash  String?
    accounts      Account[]
    sessions      Session[]
    subscriptions Subscription[]
    explanationRuns ExplanationRun[]
    chatThreads   ChatThread[]
    chatMessages  ChatMessage[]
    feedback      Feedback[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Plan {
    id           String           @id @default(cuid())
    name         String           @unique
    billingCycle PlanBillingCycle
    limits       Json
    subscriptions Subscription[]
}

model Subscription {
    id              String              @id @default(cuid())
    userId          String
    planId          String?
    status          SubscriptionStatus
    trialEndsAt     DateTime?
    stripeCustomerId String?
    stripeSubscriptionId String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    plan            Plan?    @relation(fields: [planId], references: [id])

    @@unique([userId])
}

model Instrument {
    id            String         @id @default(cuid())
    type          InstrumentType
    title         String
    authority     String
    year          Int
    effectiveFrom DateTime?
    effectiveTo   DateTime?
    status        String
    language      String
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    provisions    Provision[]
    uploads       Upload[]
}

model Provision {
    id               String        @id @default(cuid())
    instrumentId     String
    type             ProvisionType
    number           String
    text             String
    parentProvisionId String?
    createdAt        DateTime      @default(now())
    updatedAt        DateTime      @updatedAt
    instrument       Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
    parentProvision  Provision?    @relation("ProvisionHierarchy", fields: [parentProvisionId], references: [id])
    childProvisions  Provision[]   @relation("ProvisionHierarchy")
    topics           ProvisionTopic[]
    sourceMappings   Mapping[]     @relation("SourceMappings")
    targetMappings   Mapping[]     @relation("TargetMappings")
    explanationRuns  ExplanationRun[]
}

model Topic {
    id        String            @id @default(cuid())
    name      String            @unique
    createdAt DateTime          @default(now())
    provisions ProvisionTopic[]
}

model ProvisionTopic {
    provisionId String
    topicId     String
    provision   Provision @relation(fields: [provisionId], references: [id], onDelete: Cascade)
    topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

    @@id([provisionId, topicId])
}

model Mapping {
    id                 String              @id @default(cuid())
    sourceProvisionId  String
    targetProvisionId  String
    relationType       MappingRelationType
    createdAt          DateTime            @default(now())
    sourceProvision    Provision           @relation("SourceMappings", fields: [sourceProvisionId], references: [id], onDelete: Cascade)
    targetProvision    Provision           @relation("TargetMappings", fields: [targetProvisionId], references: [id], onDelete: Cascade)
}

model ExplanationRun {
    id           String   @id @default(cuid())
    provisionId  String
    userId       String
    outputText   String
    citations    Json
    createdAt    DateTime @default(now())
    provision    Provision @relation(fields: [provisionId], references: [id], onDelete: Cascade)
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatThread {
    id          String    @id @default(cuid())
    userId      String
    title       String
    contextType String
    contextIds  Json
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    messages    ChatMessage[]
}

model ChatMessage {
    id          String   @id @default(cuid())
    threadId    String
    userId      String
    role        ChatRole
    content     String
    citations   Json?
    createdAt   DateTime @default(now())
    thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
    user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Upload {
    id           String       @id @default(cuid())
    instrumentId String?
    filePath     String
    fileType     UploadFileType
    ocrUsed      Boolean      @default(false)
    createdAt    DateTime     @default(now())
    instrument   Instrument?  @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
}

model Feedback {
    id        String   @id @default(cuid())
    userId    String
    message   String
    status    String
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
